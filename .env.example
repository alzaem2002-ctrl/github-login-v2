# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/github_login_v2

# Session Secret (required in production)
# Generate a random string: openssl rand -base64 32
SESSION_SECRET=your-random-secret-key-here-change-this

# Admin Credentials (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-here

# Site Configuration
SITE_NAME=منصة علوم الذكية
ALLOW_REGISTRATION=true

# Optional - Google AI Integration
GEMINI_API_KEY=your-gemini-api-key-here

# Optional - Notion Integration
NOTION_API_KEY=your-notion-api-key-here
NOTION_DATABASE_ID=your-notion-database-id-here

# Optional - Replit API (for code execution)
REPLIT_API_KEY=your-replit-api-key
REPLIT_PROJECT_ID=your-replit-project-id

# Environment
NODE_ENV=development
PORT=5000

# Log Level
LOG_LEVEL=info
